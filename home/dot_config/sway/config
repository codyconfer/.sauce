set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term alacritty
set $menu fuzzel
set $lock swaylock -f
# Source-built tools live in ~/.local/bin, which is NOT on PATH when the
# session comes up via ly — always exec them through $bin.
set $bin ~/.local/bin
set $app uwsm app -s b --

set $ws1 "1:󰆍"
set $ws2 "2:󰖟"
set $ws3 "3:󰅩"
set $ws4 "4:󰉋"
set $ws5 "5:󰭹"
set $ws6 "6:󰝚"
set $ws7 "7:󰕧"
set $ws8 "8:󰍹"
set $ws9 "9:󰺵"
set $ws10 "10:󰀻"

output * bg #263238 solid_color

font pango:Terminess Nerd Font 14
default_border pixel 2
gaps inner 6
smart_gaps on
client.focused #03a9f4 #03a9f4 #263238 #03a9f4 #03a9f4

input "type:touchpad" {
    tap enabled
    natural_scroll disabled
    dwt enabled
}
input "type:keyboard" {
    xkb_layout us
    repeat_delay 300
    repeat_rate 40
}

exec uwsm finalize
exec $app waybar
exec $app mako
exec $app $bin/way-displays > /tmp/way-displays.${XDG_VTNR}.${USER}.log 2>&1
exec $app $bin/wl-clip-persist --clipboard regular
exec $app wlsunset -l 40.6 -L -105.1
exec $app $bin/zofi clipd
exec mkdir -p $EXPOSWAYDIR && $app $bin/exposwayd
exec $app swayidle -w \
    timeout 240 'brightnessctl -s set 10%' resume 'brightnessctl -r' \
    timeout 300 '$lock' \
    timeout 600 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep '$lock'

bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $bin/havoc
bindsym $mod+d focus mode_toggle
bindsym $mod+q kill
bindsym $mod+BackSpace kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec $bin/waylogout
bindsym $mod+F5 exec $bin/swaydim
bindsym $mod+Escape exec $lock

bindsym Print exec $bin/wayshot --clipboard
bindsym Ctrl+Print exec $bin/sway-screenshot -m output
bindsym $mod+Print exec $bin/sway-screenshot -m region --clipboard-only
bindsym $mod+Shift+Print exec $bin/sway-screenshot -m region
bindsym $mod+Ctrl+Print exec $bin/sway-screenshot -m window

bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec $bin/lumactl set +5%
bindsym --locked XF86MonBrightnessDown exec $bin/lumactl set -- -5%

bindsym $mod+$left exec $bin/sway-overfocus split-lt float-lt output-ls
bindsym $mod+$down exec $bin/sway-overfocus split-dt float-dt output-ds
bindsym $mod+$up exec $bin/sway-overfocus split-ut float-ut output-us
bindsym $mod+$right exec $bin/sway-overfocus split-rt float-rt output-rs
bindsym $mod+Tab exec $bin/sway-overfocus group-rw group-dw
bindsym $mod+Shift+Tab exec $bin/sway-overfocus group-lw group-uw
bindsym Mod1+Tab exec $bin/swaycycle
bindsym Mod1+Shift+Tab exec $bin/swaycycle --prev
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space exec $menu
bindsym $mod+x exec $bin/zofi launch
bindsym $mod+Shift+x exec $bin/zofi clipboard
bindsym $mod+z exec $bin/exposway
bindsym $mod+Shift+r exec flatpak run io.github.seadve.Kooha
bindsym $mod+a focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode "󰘖 resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "󰘖 resize"

floating_modifier $mod normal

for_window [app_id="mpv"] inhibit_idle fullscreen
for_window [app_id="swayimg"] floating enable

for_window [title=".*"] title_format "­<span size='110%' font-weight='normal'>󰘔</span> %title"

include sway-font-awesome/icons-wl
include sway-font-awesome/icons-x11
include /etc/sway/config.d/*
