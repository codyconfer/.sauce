if [ -z "${WLR_DRM_DEVICES:-}" ]; then
    for _card in /dev/dri/by-path/pci-*-card; do
        [ -e "$_card" ] || continue
        _dev="$(readlink -f "$_card")"
        _sys="/sys/class/drm/$(basename "$_dev")"
        case "$(cat "$_sys/device/vendor" 2>/dev/null)" in
            0x8086 | 0x1002) ;;
            *) continue ;;
        esac
        for _status in "$_sys"-*/status; do
            [ -e "$_status" ] || continue
            if [ "$(cat "$_status")" = connected ]; then
                export WLR_DRM_DEVICES="$_dev"
                break
            fi
        done
        [ -n "${WLR_DRM_DEVICES:-}" ] && break
    done
    unset _card _dev _sys _status
fi

