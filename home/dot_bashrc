case $- in *i*) ;; *) return ;; esac
# configs -------------------------------------------------------------------------
export DOTNET_ROOT="$HOME/.dotnet"
export PYENV_ROOT="$HOME/.pyenv"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
export OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
USR="/usr/local"
OPT="/opt"
PATH_DIRS=(
    "$OPT/bin"
    "$USR/bin"
    "$USR/go/bin"
    "$HOME/.local/bin"
    "$HOME/go/bin"
    "$PYENV_ROOT/bin"
    "$DOTNET_ROOT"
    "$DOTNET_ROOT/tools"
    "$HOME/.cargo/bin"
    "$HOME/.lmstudio/bin"
    "$HOME/.opencode/bin"
    "$HOME/google-cloud-sdk/bin"
    "$HOME/.local/share/flatpak/exports/bin"
    "/var/lib/flatpak/exports/bin"
)
RCs=(
    "$HOME/.bashrc.dev"
    "$HOME/.bashrc.ops"
    "$HOME/.bashrc.yggdrasil"
    "$HOME/.bashrc.local"
)
SAUCE_DIR="$HOME/.sauce"
THEME_DIR="$HOME/.config/oh-my-posh"
echo "☄⧗...loading ~/.bashrc"
# path handlers -------------------------------------------------------------------
for dir in "${PATH_DIRS[@]}"; do
    [ -d "$dir" ] && PATH="$PATH:$dir"
done
export PATH
# editor config -------------------------------------------------------------------
export EDITOR="nvim"
export VISUAL="nvim"
alias vi="nvim"
alias vim="nvim"
# dev env setup --------------------------------------------------------------------
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
[ -d "$PYENV_ROOT" ] && command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"
# homebrew setup if macos ----------------------------------------------------------
if [[ "$(uname)" == "Darwin" ]]; then
    for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$_brew" ] && eval "$("$_brew" shellenv)" && break
    done
    unset _brew
fi
# .sauce script handlers -----------------------------------------------------------
[ -f ~/.sauce/scripts/functions.sh ] && source ~/.sauce/scripts/functions.sh
for _script in ~/.sauce/scripts/*.sh; do
    [ -e "$_script" ] || continue
    case "$_script" in */functions.sh) continue ;; esac
    alias "$(basename "$_script" .sh)"="bash $_script"
done
unset _script
# configure bash ------------------------------------------------------------------
HISTFILE=~/.bash_history
HISTSIZE=500
HISTFILESIZE=500
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend cmdhist
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
for _bc in \
    /usr/share/bash-completion/bash_completion \
    /etc/bash_completion; do
    [ -f "$_bc" ] && source "$_bc" && break
done
unset _bc
if command -v dotnet >/dev/null 2>&1; then
    _dotnet_bash_complete() {
        local cur="${COMP_WORDS[COMP_CWORD]}"
        local candidates
        candidates=$(dotnet complete --position "$COMP_POINT" "$COMP_LINE" 2>/dev/null)
        COMPREPLY=($(compgen -W "$candidates" -- "$cur"))
    }
    complete -f -F _dotnet_bash_complete dotnet
fi
# visual components -----------------------------------------------------------------
_sauce_print_header
if command -v oh-my-posh >/dev/null 2>&1 && [ -f "$THEME_DIR/sauce.toml" ]; then
    eval "$(oh-my-posh init bash --config "$THEME_DIR/sauce.toml")"
fi
# post load -------------------------------------------------------------------------
for _rc in "${RCs[@]}"; do
    [ -r "$_rc" ] && source "$_rc"
done
unset _rc
