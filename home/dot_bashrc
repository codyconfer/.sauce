case $- in *i*) ;; *) return ;; esac
# configs -------------------------------------------------------------------------
export DOTNET_ROOT="$HOME/.dotnet"
export PYENV_ROOT="$HOME/.pyenv"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
USR="/usr/local"
OPT="/opt"
PATH_DIRS=(
    "$OPT/bin"
    "$USR/bin"
    "$USR/go/bin"
    "$HOME/.local/bin"
    "$HOME/go/bin"
    "$PYENV_ROOT/bin"
    "$DOTNET_ROOT"
    "$DOTNET_ROOT/tools"
    "$HOME/.cargo/bin"
    "$HOME/.lmstudio/bin"
    "$HOME/.opencode/bin"
    "$HOME/google-cloud-sdk/bin"
)
RCs=(
    "$HOME/.bashrc.dev"
    "$HOME/.bashrc.ops"
    "$HOME/.bashrc.yggdrasil"
    "$HOME/.bashrc.local"
)
SAUCE_DIR="$HOME/.sauce"
THEME_DIR="$HOME/.config/oh-my-posh"
echo "☄⧗...loading ~/.bashrc"
# path handlers -------------------------------------------------------------------
for dir in "${PATH_DIRS[@]}"; do
    [ -d "$dir" ] && PATH="$PATH:$dir"
done
export PATH
# editor config -------------------------------------------------------------------
export EDITOR="nvim"
export VISUAL="nvim"
alias vi="nvim"
alias vim="nvim"
# dev env setup --------------------------------------------------------------------
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
[ -d "$PYENV_ROOT" ] && eval "$(pyenv init -)"
# homebrew setup if macos ----------------------------------------------------------
if [[ "$(uname)" == "Darwin" ]]; then
    for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [ -x "$_brew" ] && eval "$("$_brew" shellenv)" && break
    done
    unset _brew
fi
# .sauce script handlers -----------------------------------------------------------
[ -f ~/.sauce/scripts/functions.sh ] && source ~/.sauce/scripts/functions.sh
for _script in ~/.sauce/scripts/*.sh; do
    [ -e "$_script" ] || continue
    case "$_script" in */functions.sh) continue ;; esac
    alias "$(basename "$_script" .sh)"="bash $_script"
done
unset _script
# configure bash ------------------------------------------------------------------
HISTFILE=~/.bash_history
HISTSIZE=10000
HISTFILESIZE=10000
shopt -s histappend
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
for _bc in \
    /usr/share/bash-completion/bash_completion \
    /etc/bash_completion; do
    [ -f "$_bc" ] && source "$_bc" && break
done
unset _bc
# visual components -----------------------------------------------------------------
_sauce_print_header
eval "$(oh-my-posh init bash --config ~/.config/oh-my-posh/sauce.toml)"
# post load -------------------------------------------------------------------------
for _rc in "${RCs[@]}"; do
    [ -r "$_rc" ] && source "$_rc"
done
unset _rc
