# .sauce — sample environment for a non-interactive bootstrap.
#
# Most variables here pre-seed the default for the matching chezmoi prompt in
# home/.chezmoi.toml.tmpl. The fleet-management block near the bottom is the
# exception: it has no prompt, and those variables alone decide whether the
# agents are installed. Unset variables fall back to the built-in defaults
# (everything selected), so you only need to set the ones you want to change.
#
#   - Booleans must be exactly "true" or "false".
#   - List variables are space-separated (e.g. SAUCE_TOOLS="go k9s rustup"); the
#     literal value "none" selects an empty set.
#
# Because the prompts are "*Once", the value is only recorded the first time.
#
# Usage — copy, edit, export, then bootstrap or apply:
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a; . ./.env; set +a          # export everything for this shell
#   bash ./bootstrap.sh                # (bootstrap.sh also auto-sources $SAUCE_DIR/.env)
#   # ...or, on an already-bootstrapped host:
#   chezmoi init --apply
#
# .env is gitignored — keep host-specific values out of the repo.

# --- desktop layer (Linux / macOS; ignored on WSL and native Windows) -------
# Headless machine — skips the entire desktop layer (emulators, GUI apps, Flatpaks).
export SAUCE_HEADLESS="false"
# Emulators. Choices: steam wine qemu
export SAUCE_EMULATORS="steam wine qemu"
# GUI apps. Choices: firefox sway alacritty gnuradio qdmr sourcegit vscode zed
#   claude codex cursor docker ghidra jetbrains-toolbox lmstudio obsidian
#   bitwarden 1password
export SAUCE_GUI_APPS="firefox sway gnuradio qdmr sourcegit vscode zed claude codex cursor docker ghidra jetbrains-toolbox lmstudio obsidian bitwarden 1password"
# Flatpaks (Flathub). Choices: slack discord signal easyeffects obs-studio
#   zen lutris retroarch zoom chirp sonic-pi
export SAUCE_FLATPAKS="slack discord signal easyeffects obs-studio zen lutris retroarch zoom chirp sonic-pi"

# --- CLI / dev tools (all platforms) ----------------------------------------
# Choices: 1password-cli aws azure-cli bitwarden-cli cloudflared gcloud gcx
#   wrangler adb claude-code dotnet go herdr k9s kubectl loglit nvim nvm ollama
#   opencode pi poetry pyenv rustup tmux yarn
#   ...plus k3s, offered only when SAUCE_HEADLESS=true on a Linux host.
export SAUCE_TOOLS="1password-cli aws azure-cli bitwarden-cli cloudflared gcloud gcx wrangler adb claude-code dotnet go herdr k9s kubectl loglit nvim nvm ollama opencode pi poetry pyenv rustup tmux yarn"

# --- media players / codecs (all platforms) ---------------------------------
# Choices: vlc audacious quodlibet ffmpeg
# The three players are offered only on a desktop host; ffmpeg is always
# offered, so a headless or WSL host can set SAUCE_MEDIA="ffmpeg". Names not
# available on this host are dropped from the default rather than erroring, so
# the full list below is safe everywhere. On Fedora this enables RPM Fusion,
# which is where vlc and the full ffmpeg build live.
export SAUCE_MEDIA="vlc audacious quodlibet ffmpeg"

# --- default kernel (Arch only) -----------------------------------------------
# setup installs the mainline `linux` kernel and makes it the default
# systemd-boot entry. Mainline allows unprivileged user namespaces, which
# Flatpak/bwrap need; linux-hardened blocks them. Other kernels you have
# installed stay selectable in the boot menu.
#export DEFAULT_KERNEL="0"                          # leave the default boot entry alone

# --- Plymouth boot splash (Arch only) -----------------------------------------
# setup installs Plymouth, adds the `plymouth` hook to mkinitcpio ahead of
# `encrypt` (mkinitcpio's own encrypt hook calls `plymouth ask-for-password`
# when plymouth is running, so the LUKS prompt becomes graphical instead of a
# bare console line), adds `quiet splash` to the kernel command line, then
# rebuilds the initramfs. Esc at the prompt switches to the text view when you
# need to read cryptsetup errors. Needs the `kms` hook for a graphical splash.
# SAUCE_PLYMOUTH_THEME seeds the "plymouthTheme" prompt. "arch" and "grafana" are
# the sauce themes in assets/plymouth/, copied to /usr/share/plymouth/themes/;
# "bgrt" reuses the firmware OEM logo, and "none" leaves boot text-only. Any
# other value is treated as an already-installed theme name. The prompt only
# appears on an Arch host that isn't WSL — nothing here installs Plymouth
# anywhere else.
export SAUCE_PLYMOUTH_THEME="arch"
#export PLYMOUTH="0"                                # skip the step outright, whatever the prompt says
#export PLYMOUTH_THEME="arch"                       # override the prompt for a single setup.sh run

# --- console font / ly scale (Linux) -----------------------------------------
# ly is a TUI on a VT, so its text size is the console font — it has no scale
# setting of its own. The sway-session step sets FONT= in /etc/vconsole.conf,
# reloads systemd-vconsole-setup, and rebuilds the initramfs when the
# `consolefont` hook is in HOOKS. The default ter-124n is 12x24, exactly 1.5x
# the 8x16 built-in font; ter-128n (14x28) and ter-132n (16x32) go bigger. This
# scales every VT, not just ly.
#export CONSOLE_FONT="ter-132n"                     # default: ter-124n; "none" leaves the font alone

# --- Wi-Fi power save (Linux, Intel iwlwifi only) -----------------------------
# Intel cards sleep between beacons and on a marginal 5 GHz link miss enough of
# them to trip mac80211's beacon-loss threshold, which drops and re-associates
# the connection every few minutes. setup drops a NetworkManager conf.d file
# setting wifi.powersave = 2 (off). Costs a little idle battery. This step is
# re-checked on every apply and exits as soon as its marker file is present, so
# a host that missed it once picks it up on the next apply.
#export WIFI_POWERSAVE="0"                          # leave Wi-Fi power management alone

# --- ClamAV (installed on Linux by default) -----------------------------------
# setup installs clamav + freshclam, enables clamav-freshclam.service for
# signature updates, and adds a sauce-managed weekly scan timer. Scans REPORT
# ONLY — nothing is deleted or quarantined.
#export CLAMAV="0"                                  # skip ClamAV entirely
#export CLAMAV_SCAN_PATHS="/home /srv"              # default: /home
#export CLAMAV_SCAN_SCHEDULE="Sun *-*-* 03:00:00"   # systemd OnCalendar
#export CLAMAV_DAEMON="1"                           # also run resident clamd (~1-2 GB RAM)

# --- secret managers (no prompt; bootstrap acts on these if set) --------------
# When any of these is set, bootstrap installs the matching CLI (via
# scripts/update-1password-cli.sh / update-bitwarden-cli.sh), walks you through
# sign-in, then re-reads this file so "$(op read ...)" style values resolve.
# Nothing happens when they are all unset, and --dry-run only reports.
#
# 1Password: OP_ACCOUNT triggers an interactive `op signin` (adding the account
# first if needed). OP_SERVICE_ACCOUNT_TOKEN / OP_CONNECT_HOST are verified
# instead of prompting. With the desktop app, turn on Settings > Developer >
# "Integrate with 1Password CLI" or the CLI cannot see your accounts.
#export OP_ACCOUNT="my.1password.com"
#
# Bitwarden: BW_ENABLE=1 opts a cloud account in without setting anything
# secret. BW_SERVER points bw at a self-hosted vault (only re-pointed when it
# differs from the current server). BW_CLIENTID +
# BW_CLIENTSECRET log in unattended via API key; BW_PASSWORD unlocks unattended
# via `bw unlock --passwordenv`. Without BW_PASSWORD the unlock needs a TTY.
# BW_SESSION is exported for the rest of the run once unlocked.
#export BW_ENABLE="1"
#export BW_SERVER="https://vault.example.com"
#export BW_CLIENTID="user.xxxxxxxx"
#export BW_CLIENTSECRET="..."
#export BW_PASSWORD="..."

# --- fleet management (no prompt; these variables are the only switch) --------
# There is no chezmoi prompt for these. update-fleet runs only when both
# variables below are set, so an unconfigured host never enrols. fleetd
# self-updates over TUF once enrolled.
#
# Fleet (fleetdm.com): with both set, update-fleet installs fleetctl, then
# builds a fleetd package with Fleet Desktop (deb / rpm / pkg.tar.zst, matching
# the distro) and installs it. Keep the secret out of this file — read it from
# your password manager, e.g. "$(op read 'op://Employee/Fleet/enroll-secret')".
#export FLEET_URL="https://fleet.example.com"
#export FLEET_ENROLL_SECRET="..."

# --- yes/no toggles ---------------------------------------------------------
# Common network/security CLI tools (nmap, dig, netcat, tcpdump, mtr, whois, ...).
export SAUCE_NET_TOOLS="true"
# Bring up Tailscale now (installs Tailscale and runs `sudo tailscale up`).
export SAUCE_TAILSCALE="false"
# Install Resilio Sync (rslsync) and create <rslsync-home>/sync, writable by the
# rslsync account and your login user (Arch only).
export SAUCE_RSLSYNC="false"

# --- native Windows only (winget) -------------------------------------------
# Set these in your PowerShell environment before `chezmoi init` on Windows.
# Choices — apps: vscode cursor zed obsidian docker-desktop jetbrains-toolbox
#   ghidra ollama lmstudio slack discord signal obs-studio bitwarden zen
#   retroarch zoom 1password vlc audacious quodlibet
# Choices — tools: go dotnet aws gcloud azure-cli kubectl k9s node nvm yarn
#   neovim gh oh-my-posh cloudflared adb 1password-cli bitwarden-cli ffmpeg
#export SAUCE_WIN_APPS="vscode cursor zed"
#export SAUCE_WIN_TOOLS="go gh node nvm"
